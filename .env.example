# ---------- Servidor ----------
PORT=3000
NODE_ENV=development
# Gere um segredo longo:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ---------- Banco de dados (MySQL 8+ / MariaDB 10.5+) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=starting_point
# true para bancos na nuvem (TiDB, Aiven etc.)
DB_SSL=false

# ---------- Armazenamento de imagens ----------
# cloudinary (recomendado, persistente) ou local (só para testes no seu computador)
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Administrador (usado por: npm run setup) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Contato (pode preencher depois) ----------
# WhatsApp: só números com DDI e DDD, ex.: 5513999999999
CONTACT_WHATSAPP=
# Instagram: só o usuário, sem @
CONTACT_INSTAGRAM=
